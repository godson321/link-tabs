{
  "manifest_version": 3,
  "name": "开链助手",
  "version": "1.3.2",
  "permissions": ["storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "src/background/service-worker.js" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*", "file:///*"],
    "js": ["src/shared/rules.js", "src/shared/settings.js", "src/shared/drag.js", "src/content/link-interceptor.js"],
    "run_at": "document_start",
    "all_frames": true
  }],
  "action": {
    "default_title": "开链助手",
    "default_popup": "src/popup/popup.html"
  },
  "options_page": "src/options/options.html"
}
